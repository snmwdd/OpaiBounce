{
  "name": "opai-liquidbounce-theme",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:music": "python3 tools/build_music.py",
    "build": "npm run build:music && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test script/tests/bridge.test.cjs",
    "test:browser": "playwright test",
    "test:music": "python3 tools/build_music.py --test",
    "verify": "python3 tools/verify.py",
    "package": "npm run build && python3 tools/package.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/dateformat": "^5.0.3",
    "sass": "^1.100.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "tslib": "^2.8.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@jhubbardsf/svelte-sortablejs": "^1.1.0",
    "@simonwep/pickr": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "chart.js": "^4.5.0",
    "chartjs-plugin-dragdata": "^2.3.1",
    "country-code-lookup": "^0.1.2",
    "dateformat": "^5.0.3",
    "nouislider": "^15.7.1",
    "qrcode": "^1.5.4",
    "svelte-spa-router": "^4.0.1"
  },
  "description": "Opai-style LiquidBounce theme and companion LiquidScript",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  }
}
